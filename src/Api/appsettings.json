{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "StackExchange.Redis": "Warning"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres;Port=5432;Database=url_shortener;Username=devuser;Password=devpass;",
    "Redis": "redis:6379",
    "RabbitMQ": "amqp://devuser:devpass@rabbitmq:5672/"
  },
  "JwtOptions": {
    "Authority": "https://auth.example.com",
    "Audience": "https://api.short.internal",
    "ValidateIssuerSigningKey": true,
    "ValidateIssuer": true,
    "ValidateAudience": true
  },
  "RateLimiting": {
    "Enabled": true
  }
}
